{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getglass",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /docs and /features (no trailing slash) are the canonical URLs.
    "html_handling": "drop-trailing-slash",
    // The Worker decides who gets the install script and counts downloads.
    // /app/ keeps its slash: the web client's relative URLs (main.js, worker.js) need it.
    // Videos too: static assets ignore Range, and Safari (and link-card players) need it.
    "run_worker_first": ["/", "/app", "/app/", "/install.sh", "/help", "/help.sh", "/releases/*", "/api/*", "/signal/*", "/og.mp4", "/mark.mp4"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "getglass",
      "database_id": "461a85fd-6d3b-45d2-b7f2-a956d8a262f0",
      "migrations_dir": "migrations"
    }
  ],
  // Remote access: introduces browsers to hosts (see src/introducer.js).
  "durable_objects": { "bindings": [{ "name": "INTRODUCER", "class_name": "Introducer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Introducer"] }],
  // Feedback is emailed to FEEDBACK_TO (a secret); downloads also go to Google Analytics
  // (GA_API_SECRET is a secret too).
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["feedback@glassdesk.dev"] }],
  "vars": { "GA_MEASUREMENT_ID": "G-LCYDPMQMLD" },
  "routes": [{ "pattern": "glassdesk.dev", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
